# /etc/fstab for basic Linux on SD card
# Mount by label names: DATA, SYSTEM, SDCARD

proc /proc proc defaults 0 0
sysfs /sys sysfs defaults 0 0
devpts /dev/pts devpts defaults,gid=5,mode=0620 0 0

# Mount DATA partition (label: DATA)
/dev/block/mmcblk0p1 /data ext4 defaults,noatime 0 2

# Mount SYSTEM partition (label: SYSTEM)  
/dev/block/mmcblk0p2 /system ext4 defaults,noatime 0 2

# Mount SDCARD partition (label: SDCARD)
/dev/block/mmcblk0p3 /sdcard ext4 defaults,noatime 0 2
